{
  "version": 1,
  "root": "main_sm",
  "nodes": [
    {
      "name": "main_sm",
      "type": "state_machine",
      "states": [
        {
          "name": "idle",
          "interp_time": 0.2,
          "transitions": [
            {
              "var": "on_move",
              "dst_state": "move"
            }
          ]
        },
        {
          "name": "move",
          "interp_time": 0.2,
          "transitions": [
            {
              "var": "on_idle",
              "dst_state": "idle"
            }
          ]
        }
      ],
      "children": [
        "idle_motion",
        "move_blend"
      ]
    },
    {
      "name": "idle_motion",
      "type": "motion",
      "loop": true,
      "src": "anim/idle.glb",
      "sample_rate": 30.0
    },
    {
      "name": "move_blend",
      "type": "blend",
      "alpha": "speed_alpha",
      "children": [
        "walk_motion",
        "run_motion"
      ]
    },
    {
      "name": "walk_motion",
      "type": "motion",
      "loop": true,
      "src": "anim/walk.glb",
      "sample_rate": 30.0
    },
    {
      "name": "run_motion",
      "type": "motion",
      "loop": true,
      "src": "anim/run.glb",
      "sample_rate": 30.0
    }
  ]
}
